# LLM Configuration
# Choose default provider: "gemini" or "groq"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get at: https://aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key (Optional alternative, get at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Neo4j Database Credentials (Default local Docker credentials)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
